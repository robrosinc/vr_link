// Wire schema of vr_link: the VR pose/input uplink (headset -> PC, VRS1) and
// the video/robot-state downlink (PC -> headset, VRL2; see the bottom half).
//
// Framing (the schema does NOT include it): each record on the TCP byte
// stream is preceded by an 8-byte big-endian prefix:
//
//   magic  u32 = 0x56525331 ("VRS1")
//   length u32 = size of the FlatBuffers payload in bytes
//
// See README.md for the full contract (coordinate conventions, joint order,
// evolution rules).

namespace robros.vr;

// Fixed-size pose, stored inline. Position in meters, quaternion in wxyz
// order, both expressed in the simulation world frame (Z-up, right-handed).
struct Pose {
  px: float;
  py: float;
  pz: float;
  qw: float;
  qx: float;
  qy: float;
  qz: float;
  valid: bool;
}

// One hand controller's input state. Buttons are floats so analog values
// (trigger/grip pressure) and binary buttons (0.0/1.0) share one shape.
table ControllerInput {
  trigger: float;
  grip: float;
  button_first: float;       // right controller: A, left controller: X
  button_second: float;      // right controller: B, left controller: Y
  button_thumbstick: float;  // thumbstick click
  thumbstick_x: float;       // [-1, 1]
  thumbstick_y: float;       // [-1, 1]
  // 2.1: the XR runtime currently tracks this controller (the operator holds
  // it). Lets receivers tell "controller in hand, idle" from "bare hand out
  // of view" when hand tracking is off; false from senders without the field.
  tracked: bool = false;
}

// Hand-tracking keypoints for one hand, for finger teleoperation. The sender
// transmits raw keypoints only; retargeting onto the robot hand happens on
// the receiver.
table HandState {
  // Per-frame tracking flag. When false the receiver must not act on
  // keypoints (hand-tracking runtimes keep serving stale last-known poses
  // after tracking is lost, e.g. when the user grabs a controller).
  tracked: bool;

  // Hand-tracking wrist pose in the simulation world frame (same conventions
  // as body_joints, but no retargeting convention adapter is applied). Sent
  // explicitly because the body-tracking wrist in body_joints comes from a
  // different runtime source and differs from the hand-tracking wrist by a
  // per-hand yaw convention offset.
  wrist: Pose;

  // Exactly 26 entries in the OpenXR XR_EXT_hand_tracking joint order (see
  // README.md). Poses are relative to the wrist keypoint, expressed in the
  // wrist frame with the same axis handedness conversion as all other poses;
  // entry 1 (the wrist itself) is therefore the identity pose. Each entry's
  // `valid` mirrors the runtime's per-keypoint validity.
  keypoints: [Pose];
}

// Headset teleop control state machine (vr_system ETeleopControlState + Unknown).
enum TeleopState : ubyte { Unknown = 0, Stopped = 1, Countdown = 2, Resuming = 3, Active = 4, Paused = 5 }

// One snapshot of VR tracking + controller input, sent at the tracking rate.
// Always carries the full current state (never deltas/events) so a receiver
// that keeps only the newest record loses nothing on packet drop.
table VRState {
  // Sender clock, informational.
  timestamp_ns: ulong;

  // Device-fused full-body skeleton: exactly 24 entries in the PICO/SMPL-X
  // body order the GMR "xrobot" retargeting source consumes (see README.md).
  body_joints: [Pose];

  // Raw HMD pose for head teleoperation. Unlike body_joints, the receiver
  // applies no retargeting convention adapter to this slot.
  head: Pose;

  left_input: ControllerInput;
  right_input: ControllerInput;

  // Hand-tracking keypoints for finger teleoperation. Absent (null) when the
  // sender build/device does not provide hand tracking; present with
  // tracked=false when the hand is merely not tracked this frame.
  left_hand: HandState;
  right_hand: HandState;

  // Headset-UI recording toggle requests, as a monotonic counter (state, not
  // an event: a one-frame pulse could be lost to the receiver's newest-only
  // sampling). The receiver applies (new - last_seen) % 2 toggles and seeds
  // last_seen from the first record of a connection.
  record_toggle_count: uint;

  // Headset teleop control state at the time of this record (2.1). State, not
  // an event: the receiver detects transitions itself (e.g. Resuming starts
  // the robot-side convergence ramp). Paused/Countdown records are frozen
  // snapshots re-sent with fresh timestamps; this field is always live.
  // Unknown (0) is what senders older than this field produce.
  teleop_state: TeleopState = Unknown;
}

// ---------------------------------------------------------------------------
// Downlink (PC -> headset). vr_link 2.0 replaced the VSTR 48-byte header and
// its codec records with framed FlatBuffers Envelopes. One record on the 9100
// stream, and each of the request and the reply on 9101, is:
//
//   magic  u32 = 0x56524C32 ("VRL2")
//   length u32 = size of the FlatBuffers payload in bytes
//   payload    = robros.vr.Envelope   (parse with GetRoot<Envelope>;
//                root_type stays VRState for the uplink)
//
// Every record carries full current state (never events). seq increases by
// one per Envelope on a connection. The Signals and RobotState records that
// belong to a video frame are sent immediately BEFORE that VideoFrame and
// carry the same wall_ns/sim_ns and consecutive seq values; receivers pair
// them on (wall_ns, sim_ns) or on the sender order.
// ---------------------------------------------------------------------------

// Which kind of system produced the stream (HUD label, no behaviour change).
enum SourceKind : ubyte { Unknown = 0, Robot = 1, MuJoCo = 2, Isaac = 3 }

// One H.264 Annex-B access unit of the side-by-side stereo frame (right eye
// in the LEFT half, matching the hardware). SPS/PPS are repeated in-band on
// every IDR; a receiver gets nothing before the first key frame.
table VideoFrame {
  codec: ubyte = 1;        // 1 = H.264 (the only value in 2.0)
  width: uint;             // SBS frame width (both eyes)
  height: uint;
  is_key: bool;
  data: [ubyte];
}

// Per-eye camera model in pixels of the per-eye image: OpenCV fisheye
// intrinsics, k1..k4 (a pinhole sender uses the tan(theta) Taylor series,
// never zeros) and the stereoRectify rotation r (9 floats, row-major, eye
// optical frame -> mid frame).
table CameraModel {
  fx: float;
  fy: float;
  cx: float;
  cy: float;
  k1: float;
  k2: float;
  k3: float;
  k4: float;
  r: [float];              // exactly 9
}

// Stereo calibration. Sent once per 9100 connection before any video and as
// the 9101 reply to a CalibrationRequest.
table Calibration {
  image_width: uint;       // per-eye
  image_height: uint;
  left: CameraModel;
  right: CameraModel;
}

// 9101 request body. Empty: the connection itself is the request.
table CalibrationRequest {}

// Robot joint state matched (by the sender) to the video frame it precedes.
// Each group has its own valid flag and source stamp (0 when unknown); an
// invalid group carries an empty vector and must be ignored by the receiver.
//
// body_*: exactly 31 radians in the igris_c_sdk joint-space order:
//   waist yaw/roll/pitch; left leg hip pitch/roll/yaw, knee, ankle pitch/roll;
//   right leg (same); left arm shoulder pitch/roll/yaw, elbow, wrist yaw/roll/
//   pitch; right arm (same); neck yaw, neck pitch.
// hand_*: exactly 12 in motor-id order 11..16 (right: thumb flexion, index,
//   middle, ring, little, thumb CMC) then 21..26 (left, same layout).
//   hand_actual = HandState.motor_state[i].q; hand_command =
//   HandCmd.motor_cmd[i].q (normalized, 0 = open, 1 = closed).
table RobotState {
  body_actual: [float];            // LowState.joint_state[i].q
  body_actual_valid: bool;
  body_actual_stamp_ns: ulong;

  body_reference: [float];         // gmr/refstate (MasterArmState.joint_state[i].q)
  body_reference_valid: bool;
  body_reference_stamp_ns: ulong;

  hand_actual: [float];            // HandState.motor_state[i].q
  hand_actual_valid: bool;
  hand_actual_stamp_ns: ulong;

  hand_command: [float];           // HandCmd.motor_cmd[i].q
  hand_command_valid: bool;
  hand_command_stamp_ns: ulong;

  // Robot base pose in the simulation world frame (Z-up, right-handed,
  // metres, wxyz). Pose.valid is false when the sender has no estimate
  // (the real robot).
  base_pose: Pose;
}

// Sender-side flags. Replaces the 1.x SimStatus record. Sent with every video
// frame and, when the source delivers no frames (NO CAMERA targets), as a
// periodic state-only heartbeat together with RobotState.
table Signals {
  recording: bool;                 // episode data recording active on the PC side
  source: SourceKind = Unknown;

  // Teleop producer feedback (2.1): the robot-side reference is converging
  // from the robot's measured pose to the operator's pose (after Start/Resume
  // or a low-level mode entry); progress 0..1. False/0 while idle or when the
  // producer does not report.
  converging: bool = false;
  converge_progress: float = 0.0;
  // The producer holds the robot arm at its last pose because the operator's
  // bare hand is not tracked (no controller, hand occluded). Per side.
  arm_hold_left: bool = false;
  arm_hold_right: bool = false;
}

union Message { VideoFrame, Calibration, CalibrationRequest, RobotState, Signals }

table Envelope {
  schema_version: uint = 2;
  seq: uint;
  wall_ns: ulong;                  // CLOCK_REALTIME of the frame / sample
  sim_ns: ulong;                   // simulation time, 0 for real cameras
  body: Message;
}

root_type VRState;
