// Wire schema for the VR pose/input uplink (headset/Unreal -> simulation PC).
//
// Framing (the schema does NOT include it): each record on the TCP byte
// stream is preceded by an 8-byte big-endian prefix:
//
//   magic  u32 = 0x56525331 ("VRS1")
//   length u32 = size of the FlatBuffers payload in bytes
//
// See README.md for the full contract (coordinate conventions, joint order,
// evolution rules).

namespace robros.vr;

// Fixed-size pose, stored inline. Position in meters, quaternion in wxyz
// order, both expressed in the simulation world frame (Z-up, right-handed).
struct Pose {
  px: float;
  py: float;
  pz: float;
  qw: float;
  qx: float;
  qy: float;
  qz: float;
  valid: bool;
}

// One hand controller's input state. Buttons are floats so analog values
// (trigger/grip pressure) and binary buttons (0.0/1.0) share one shape.
table ControllerInput {
  trigger: float;
  grip: float;
  button_first: float;       // right controller: A, left controller: X
  button_second: float;      // right controller: B, left controller: Y
  button_thumbstick: float;  // thumbstick click
  thumbstick_x: float;       // [-1, 1]
  thumbstick_y: float;       // [-1, 1]
}

// Hand-tracking keypoints for one hand, for finger teleoperation. The sender
// transmits raw keypoints only; retargeting onto the robot hand happens on
// the receiver.
table HandState {
  // Per-frame tracking flag. When false the receiver must not act on
  // keypoints (hand-tracking runtimes keep serving stale last-known poses
  // after tracking is lost, e.g. when the user grabs a controller).
  tracked: bool;

  // Hand-tracking wrist pose in the simulation world frame (same conventions
  // as body_joints, but no retargeting convention adapter is applied). Sent
  // explicitly because the body-tracking wrist in body_joints comes from a
  // different runtime source and differs from the hand-tracking wrist by a
  // per-hand yaw convention offset.
  wrist: Pose;

  // Exactly 26 entries in the OpenXR XR_EXT_hand_tracking joint order (see
  // README.md). Poses are relative to the wrist keypoint, expressed in the
  // wrist frame with the same axis handedness conversion as all other poses;
  // entry 1 (the wrist itself) is therefore the identity pose. Each entry's
  // `valid` mirrors the runtime's per-keypoint validity.
  keypoints: [Pose];
}

// One snapshot of VR tracking + controller input, sent at the tracking rate.
// Always carries the full current state (never deltas/events) so a receiver
// that keeps only the newest record loses nothing on packet drop.
table VRState {
  // Sender clock, informational.
  timestamp_ns: ulong;

  // Device-fused full-body skeleton: exactly 24 entries in the PICO/SMPL-X
  // body order the GMR "xrobot" retargeting source consumes (see README.md).
  body_joints: [Pose];

  // Raw HMD pose for head teleoperation. Unlike body_joints, the receiver
  // applies no retargeting convention adapter to this slot.
  head: Pose;

  left_input: ControllerInput;
  right_input: ControllerInput;

  // Hand-tracking keypoints for finger teleoperation. Absent (null) when the
  // sender build/device does not provide hand tracking; present with
  // tracked=false when the hand is merely not tracked this frame.
  left_hand: HandState;
  right_hand: HandState;

  // Headset-UI recording toggle requests, as a monotonic counter (state, not
  // an event: a one-frame pulse could be lost to the receiver's newest-only
  // sampling). The receiver applies (new - last_seen) % 2 toggles and seeds
  // last_seen from the first record of a connection.
  record_toggle_count: uint;
}

// Downlink status record (simulation PC -> headset), carried on the VSTR
// video channel (port 9100) as a codec=5 record. Framing, sequence and
// timestamps come from the VSTR header; this table is the payload. Like
// VRState it always carries full current state (never events), so a receiver
// that keeps only the newest record loses nothing. Parse with
// GetRoot<SimStatus> (root_type stays VRState).
table SimStatus {
  // Sender wall clock, informational.
  timestamp_ns: ulong;

  // Episode data recording is active on the simulation side.
  recording: bool;
}

root_type VRState;
